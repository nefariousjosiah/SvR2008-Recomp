// SvR 2008 addresses for the XDK D3D functions that re:Blue's renderer hooks by name.
//
// Force-included into the native renderer sources (cmake/native_renderer.cmake), so
// REX_HOOK(D3DDevice_Clear, ...) overrides SvR's recompiled sub_8224E9D8 and
// __imp__D3DDevice_Clear calls its original body. Every entry is confirmed by behaviour
// (config/native/d3d_names.toml has the evidence). Functions not listed here are either not used
// by SvR's engine or not identified yet; a hook that names one fails to compile on purpose.

#pragma once

// Device / frame
#define D3DDevice_Present                     sub_8223AEF8
#define D3DDevice_Swap                        sub_8223A960
#define D3DDevice_SynchronizeToPresentationInterval sub_8223A4B8
#define D3DDevice_Resolve                     sub_82249340
#define D3DDevice_Clear                       sub_8224E9D8
#define D3DDevice_SetRenderTarget             sub_822407E0
#define D3DDevice_SetDepthStencilSurface      sub_82240B48
#define D3DDevice_SetScissorRect              sub_8223FD58

// Draws
#define D3DDevice_BeginVertices               sub_825AAF28
#define D3DDevice_EndVertices                 sub_825AB3C8
#define D3DDevice_DrawVertices                sub_825AB3E8
#define D3DDevice_DrawIndexedVertices         sub_825AB7D0

// Resource creation
#define D3DDevice_CreateVertexDeclaration     sub_82242D18
#define D3DDevice_CreateVertexShader          sub_82242FE0
#define D3DDevice_CreatePixelShader           sub_82242ED0

// State
#define D3DDevice_SetTexture                  sub_82237868
#define D3DDevice_SetVertexShader             sub_822429F8
#define D3DDevice_SetPixelShader              sub_822426F8
#define D3DDevice_SetVertexDeclaration        sub_82242C10
#define D3DDevice_SetStreamSource             sub_8223FEA8
#define D3DDevice_SetIndices                  sub_82240050

// Original bodies (__imp__ = the recompiled function, for hooks that call through).
#define __imp__D3DDevice_Present              __imp__sub_8223AEF8
#define __imp__D3DDevice_Swap                 __imp__sub_8223A960
#define __imp__D3DDevice_Resolve              __imp__sub_82249340
#define __imp__D3DDevice_Clear                __imp__sub_8224E9D8
#define __imp__D3DDevice_SetTexture           __imp__sub_82237868
#define __imp__D3DDevice_SetRenderTarget      __imp__sub_822407E0
#define __imp__D3DDevice_SetDepthStencilSurface __imp__sub_82240B48
#define __imp__D3DDevice_SetScissorRect       __imp__sub_8223FD58
#define __imp__D3DDevice_BeginVertices        __imp__sub_825AAF28
#define __imp__D3DDevice_EndVertices          __imp__sub_825AB3C8
#define __imp__D3DDevice_DrawVertices         __imp__sub_825AB3E8
#define __imp__D3DDevice_DrawIndexedVertices  __imp__sub_825AB7D0
#define __imp__D3DDevice_CreateVertexDeclaration __imp__sub_82242D18
#define __imp__D3DDevice_CreateVertexShader   __imp__sub_82242FE0
#define __imp__D3DDevice_CreatePixelShader    __imp__sub_82242ED0
#define __imp__D3DDevice_SetVertexShader      __imp__sub_822429F8
#define __imp__D3DDevice_SetPixelShader       __imp__sub_822426F8
#define __imp__D3DDevice_SetVertexDeclaration __imp__sub_82242C10
#define __imp__D3DDevice_SetStreamSource      __imp__sub_8223FEA8
#define __imp__D3DDevice_SetIndices           __imp__sub_82240050

// Resource description getters (re:Blue answers them for host-created resources and calls the
// original otherwise). Surface/VolumeTexture: identical size to Blue Dragon's; Texture: near.
#define __imp__D3DSurface_GetDesc             __imp__sub_82237748
#define __imp__D3DTexture_GetLevelDesc        __imp__sub_82235A48
#define __imp__D3DVolumeTexture_GetLevelDesc  __imp__sub_82236C08
